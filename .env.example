CLAUDE_API_KEY=sk-ant-your-key-here
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://localhost:8000/api/whoop/callback
PORT=8000
GAME_MODE=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Local IDE workspace (file ops + terminal cwd + LSP root are confined here)
WORKSPACE_ROOT=./workspace

# Privileged local features — default OFF (fail-safe). Enable ONLY on a local machine.
# DO NOT enable on a public deploy: they expose a real shell + filesystem on the host.
TERMINAL_ENABLED=false
FILES_ENABLED=false
LSP_ENABLED=false
INLINE_AI_ENABLED=false
# "Open in full VS Code" launches code-server locally (install: code-server.dev/install.sh)
CODE_SERVER_ENABLED=false
