CLAUDE_API_KEY=sk-ant-your-key-here
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://localhost:8000/api/whoop/callback
PORT=8000
GAME_MODE=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Local IDE workspace (file ops + terminal cwd + LSP root are confined here)
WORKSPACE_ROOT=./workspace

# Privileged local features — default OFF (fail-safe). Enable ONLY on a local machine.
# DO NOT enable on a public deploy: they expose a real shell + filesystem on the host.
TERMINAL_ENABLED=false
FILES_ENABLED=false
LSP_ENABLED=false
INLINE_AI_ENABLED=false
# "Open in full VS Code" launches code-server locally (install: code-server.dev/install.sh)
CODE_SERVER_ENABLED=false

# Spotify Web Playback SDK — link your own Spotify account to the speaker in the room.
# Full setup guide: docs/spotify-setup.md
# Requires Spotify Premium + a dev app at https://developer.spotify.com/dashboard
#   1. Create App, bifează Web Playback SDK + Web API
#   2. Redirect URIs: http://localhost:5173/  (and your prod origin + /)
#   3. Copy Client ID below, restart `npm run dev` (Vite reads .env on boot)
# Leave blank to hide the integration entirely (speaker falls back to the procedural pad).
VITE_SPOTIFY_CLIENT_ID=
